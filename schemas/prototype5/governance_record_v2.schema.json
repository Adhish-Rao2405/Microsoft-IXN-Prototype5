{
  "$defs": {
    "CorrectnessStatus": {
      "enum": [
        "CORRECT",
        "INCORRECT",
        "NOT_ASSESSABLE",
        "NOT_EVALUATED",
        "ERROR"
      ],
      "title": "CorrectnessStatus",
      "type": "string"
    },
    "DomainId": {
      "enum": [
        "MANUFACTURING",
        "HEALTHCARE_SYNTHETIC"
      ],
      "title": "DomainId",
      "type": "string"
    },
    "EvaluationMode": {
      "enum": [
        "LIVE",
        "EVALUATION"
      ],
      "title": "EvaluationMode",
      "type": "string"
    },
    "FallbackReason": {
      "enum": [
        "NONE",
        "LOCAL_UNAVAILABLE",
        "LOCAL_MODEL_NOT_READY",
        "LOCAL_TIMEOUT",
        "LOCAL_TRANSPORT_ERROR",
        "LOCAL_EMPTY_RESPONSE",
        "LOCAL_PARSE_FAILURE",
        "LOCAL_JSON_FAILURE",
        "LOCAL_SCHEMA_FAILURE",
        "LOCAL_CIRCUIT_OPEN",
        "LOCAL_ROLLING_RELIABILITY_BELOW_THRESHOLD",
        "LOCAL_LATENCY_THRESHOLD_EXCEEDED"
      ],
      "title": "FallbackReason",
      "type": "string"
    },
    "FinalDecision": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "CLARIFY",
        "ERROR"
      ],
      "title": "FinalDecision",
      "type": "string"
    },
    "GateId": {
      "enum": [
        "PARSE",
        "JSON",
        "SCHEMA",
        "SEMANTICS",
        "AMBIGUITY",
        "SAFETY",
        "AUTHORITY"
      ],
      "title": "GateId",
      "type": "string"
    },
    "GateLatencyRecord": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "$ref": "#/$defs/GateId"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        }
      },
      "required": [
        "gate",
        "latency_ms"
      ],
      "title": "GateLatencyRecord",
      "type": "object"
    },
    "GateReasonRecord": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "$ref": "#/$defs/GateId"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "gate",
        "reason_codes"
      ],
      "title": "GateReasonRecord",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_ASSESSABLE",
        "NOT_EVALUATED",
        "ERROR"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "InferenceMode": {
      "enum": [
        "LOCAL",
        "CLOUD",
        "AUTO"
      ],
      "title": "InferenceMode",
      "type": "string"
    },
    "InputMode": {
      "enum": [
        "TYPED",
        "VOICE"
      ],
      "title": "InputMode",
      "type": "string"
    },
    "PlanSemanticStatus": {
      "enum": [
        "VALID",
        "INVALID",
        "NOT_ASSESSABLE_NO_PROPOSAL",
        "NOT_ASSESSABLE_PARSE_FAILED",
        "NOT_ASSESSABLE_SCHEMA_INVALID",
        "NOT_ASSESSABLE_MISSING_ORACLE",
        "NOT_ASSESSABLE_MISSING_REQUIRED_CONTEXT",
        "NOT_EVALUATED",
        "ERROR"
      ],
      "title": "PlanSemanticStatus",
      "type": "string"
    },
    "ProvenanceRecordV2": {
      "additionalProperties": false,
      "properties": {
        "benchmark_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Sha256"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "oracle_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Sha256"
        },
        "policy_sha256": {
          "title": "Policy Sha256",
          "type": "string"
        },
        "prompt_id": {
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "software_commit": {
          "title": "Software Commit",
          "type": "string"
        },
        "source_repository": {
          "minLength": 1,
          "title": "Source Repository",
          "type": "string"
        }
      },
      "required": [
        "source_repository",
        "software_commit",
        "prompt_id",
        "prompt_version",
        "model_provider",
        "policy_sha256"
      ],
      "title": "ProvenanceRecordV2",
      "type": "object"
    },
    "ProviderId": {
      "enum": [
        "FOUNDRY_LOCAL",
        "CLOUD",
        "NONE"
      ],
      "title": "ProviderId",
      "type": "string"
    },
    "RoutingRecordV2": {
      "additionalProperties": false,
      "properties": {
        "cloud_attempted": {
          "title": "Cloud Attempted",
          "type": "boolean"
        },
        "cloud_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cloud Latency Ms"
        },
        "fallback_reason": {
          "$ref": "#/$defs/FallbackReason",
          "default": "NONE"
        },
        "fallback_triggered": {
          "default": false,
          "title": "Fallback Triggered",
          "type": "boolean"
        },
        "local_attempted": {
          "title": "Local Attempted",
          "type": "boolean"
        },
        "local_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Latency Ms"
        },
        "requested_mode": {
          "$ref": "#/$defs/InferenceMode"
        },
        "selected_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Model"
        },
        "selected_provider": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "required": [
        "requested_mode",
        "selected_provider",
        "local_attempted",
        "cloud_attempted"
      ],
      "title": "RoutingRecordV2",
      "type": "object"
    },
    "SimulationStatus": {
      "enum": [
        "NOT_REQUESTED",
        "NOT_STARTED",
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "STOPPED_BY_OPERATOR",
        "FAILED"
      ],
      "title": "SimulationStatus",
      "type": "string"
    },
    "TranscriptStatus": {
      "enum": [
        "NOT_APPLICABLE",
        "READY",
        "PARTIAL",
        "EMPTY",
        "BACKEND_UNAVAILABLE",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TranscriptStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguity_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "audio_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Sha256"
    },
    "authority_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "benchmark_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Id"
    },
    "decision_correctness_status": {
      "$ref": "#/$defs/CorrectnessStatus"
    },
    "decision_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Decision Reason Codes",
      "type": "array"
    },
    "domain_id": {
      "$ref": "#/$defs/DomainId"
    },
    "evaluation_mode": {
      "$ref": "#/$defs/EvaluationMode"
    },
    "evidence_schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Evidence Schema Version",
      "type": "string"
    },
    "execution_eligible": {
      "title": "Execution Eligible",
      "type": "boolean"
    },
    "execution_permit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Permit Id"
    },
    "expected_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_decision": {
      "$ref": "#/$defs/FinalDecision"
    },
    "gate_latencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateLatencyRecord"
      },
      "title": "Gate Latencies",
      "type": "array"
    },
    "gate_reasons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateReasonRecord"
      },
      "title": "Gate Reasons",
      "type": "array"
    },
    "input_mode": {
      "$ref": "#/$defs/InputMode"
    },
    "json_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "normalised_command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalised Command"
    },
    "oracle_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oracle Version"
    },
    "parse_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "plan_semantic_status": {
      "$ref": "#/$defs/PlanSemanticStatus"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceRecordV2"
    },
    "provider_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Latency Ms"
    },
    "raw_response_present": {
      "title": "Raw Response Present",
      "type": "boolean"
    },
    "raw_response_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response Sha256"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "routing": {
      "$ref": "#/$defs/RoutingRecordV2"
    },
    "safety_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "schema_status": {
      "$ref": "#/$defs/GateStatus"
    },
    "simulation_status": {
      "$ref": "#/$defs/SimulationStatus",
      "default": "NOT_REQUESTED"
    },
    "timestamp_utc": {
      "title": "Timestamp Utc",
      "type": "string"
    },
    "total_pipeline_latency_ms": {
      "minimum": 0,
      "title": "Total Pipeline Latency Ms",
      "type": "number"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "transcript_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Backend"
    },
    "transcript_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Confidence"
    },
    "transcript_status": {
      "$ref": "#/$defs/TranscriptStatus",
      "default": "NOT_APPLICABLE"
    },
    "transcript_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Text"
    },
    "typed_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Typed Text"
    },
    "validation_latency_ms": {
      "minimum": 0,
      "title": "Validation Latency Ms",
      "type": "number"
    }
  },
  "required": [
    "record_id",
    "trace_id",
    "timestamp_utc",
    "evaluation_mode",
    "input_mode",
    "domain_id",
    "policy_id",
    "routing",
    "raw_response_present",
    "parse_status",
    "json_status",
    "schema_status",
    "plan_semantic_status",
    "ambiguity_status",
    "safety_status",
    "authority_status",
    "decision_correctness_status",
    "final_decision",
    "execution_eligible",
    "decision_reason_codes",
    "validation_latency_ms",
    "total_pipeline_latency_ms",
    "provenance"
  ],
  "title": "GovernanceRecordV2",
  "type": "object"
}
