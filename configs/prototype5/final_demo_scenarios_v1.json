  "authority_taxonomy": {
    "ordered_states": [
      "UNTRUSTED_PROPOSAL",
      "GOVERNANCE_DECISION",
      "EXECUTION_ELIGIBILITY",
      "QUALIFICATION_REPLAY_ACCESS",
      "DOWNSTREAM_GEOMETRIC_QUALIFICATION",
      "PHYSICAL_EXECUTION_AUTHORITY_NOT_IMPLEMENTED"
    ],
    "model_proposal": {
      "label": "UNTRUSTED PROPOSAL",
      "authority": "NONE",
      "description": "Model or provider output that has not established any downstream authority."
    },
    "governance_decision": {
      "states": [
        "ACCEPT",
        "CLARIFY",
        "REJECT"
      ],
      "description": "The deterministic result of parse, JSON, schema, policy-scoped semantics, ambiguity, safety/policy and role/action-policy evaluation."
    },
    "execution_eligibility": {
      "label": "EXECUTION ELIGIBILITY",
      "description": "The proposal passed the evaluated deterministic governance gates and may proceed only to a separately bounded downstream qualification step.",
      "does_not_establish": [
        "GEOMETRIC_VALIDITY",
        "COLLISION_FREEDOM",
        "PHYSICAL_SAFETY",
        "DYNAMIC_EXECUTABILITY",
        "ROBOT_EXECUTION_AUTHORITY"
      ]
    },
    "qualification_replay_access": {
      "label": "QUALIFICATION_REPLAY_ACCESS",
      "states": [
        "NOT_REQUESTED",
        "DENIED",
        "GRANTED"
      ],
      "description": "A demo-only capability allowing one server-resolved registered operation to read and replay exact frozen B2/B3.2 evidence. It is not execution authority."
    },
    "downstream_geometric_qualification": {
      "label": "DOWNSTREAM GEOMETRIC QUALIFICATION",
      "states": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "NOT_REQUESTED"
      ],
      "frozen_b3_2_state": "FAIL"
    },
    "physical_execution_authority": {
      "label": "PHYSICAL EXECUTION AUTHORITY",
      "state": "NOT_IMPLEMENTED",
      "description": "No physical robot execution authority or dynamic PyBullet execution authority exists in the final demonstrator."
    },
    "layer_invariant": "PASSING LAYER N DOES NOT ESTABLISH LAYER N+1."
  },
  "provenance_policy": {
    "invariant": "LIVE_MODEL_PROPOSAL != FROZEN_B2_PLAN",
    "live_inference_output_state": "UNTRUSTED_PROPOSAL",
    "live_governance_may_contextualise_frozen_evidence": true,
    "live_model_proposal_is_frozen_b2_provenance_source": false,
    "live_model_proposal_is_b3_1_b3_2_provenance_source": false,
    "sequential_presentation_relationship": "CONTEXTUAL_ONLY_NOT_DERIVATIONAL",
    "frozen_evidence_provenance": "INDEPENDENT_HISTORICAL_PROVENANCE",
    "dedicated_replay_artifact_source": "EXACT_BOUND_FROZEN_ARTIFACTS_ONLY"
